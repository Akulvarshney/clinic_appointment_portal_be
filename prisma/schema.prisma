model inventory_items {
  id                 String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String                   @db.Uuid
  name               String                   @db.VarChar(255)
  sku                String?                  @db.VarChar(100)
  description        String?
  inventory_type     inventory_type           @default(RETAIL)
  unit               String                   @default("unit") @db.VarChar(50)
  reorder_level      Decimal?                 @db.Decimal(14, 4)
  is_valid           Boolean                  @default(true)
  created_at         DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?                @default(now()) @db.Timestamptz(6)
  organizations      organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_batches  inventory_batches[]
  inventory_transactions inventory_transactions[]
  bill_line_items    bill_line_items[]

  @@index([organization_id], map: "idx_inventory_items_organization_id")
  @@index([organization_id, is_valid], map: "idx_inventory_items_org_valid")
  @@unique([organization_id, sku], map: "uq_inventory_org_sku")
}

model inventory_batches {
  id                 String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String                   @db.Uuid
  inventory_item_id  String                   @db.Uuid
  batch_number       String                   @db.VarChar(100)
  expiry_date        DateTime?                @db.Date
  quantity_on_hand   Decimal                  @default(0) @db.Decimal(14, 4)
  cost_price         Decimal?                 @db.Decimal(12, 2)
  selling_price      Decimal?                 @db.Decimal(12, 2)
  mrp                Decimal?                 @db.Decimal(12, 2)
  is_valid           Boolean                  @default(true)
  created_at         DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?                @default(now()) @db.Timestamptz(6)
  organizations      organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_items      inventory_items        @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_transactions inventory_transactions[]
  bill_line_items      bill_line_items[]

  @@unique([inventory_item_id, batch_number], map: "uq_inv_item_batch_number")
  @@index([organization_id], map: "idx_inv_batches_org")
  @@index([inventory_item_id], map: "idx_inv_batches_item")
}

model inventory_transactions {
  id                 String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String                     @db.Uuid
  inventory_item_id  String                     @db.Uuid
  inventory_batch_id String?                    @db.Uuid
  transaction_type   inventory_transaction_type
  quantity_delta     Decimal                    @db.Decimal(14, 4)
  quantity_before    Decimal                    @db.Decimal(14, 4)
  quantity_after     Decimal                    @db.Decimal(14, 4)
  batch_number       String?                    @db.VarChar(100)
  remarks            String?                    @db.VarChar(500)
  created_at         DateTime?                  @default(now()) @db.Timestamptz(6)
  source_bill_id     String?                    @db.Uuid
  inventory_items    inventory_items            @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_batches  inventory_batches?         @relation(fields: [inventory_batch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  organizations      organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source_bill        bills?                     @relation("inventory_tx_source_bill", fields: [source_bill_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([organization_id], map: "idx_inventory_tx_organization_id")
  @@index([inventory_item_id], map: "idx_inventory_tx_item_id")
  @@index([inventory_batch_id], map: "idx_inventory_tx_batch_id")
  @@index([source_bill_id], map: "idx_inventory_tx_source_bill_id")
  @@index([created_at], map: "idx_inventory_tx_created_at")
}

enum inventory_transaction_type {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum inventory_type {
  RETAIL
  CONSUMABLE
}
